generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum OtpPurpose {
  CHANGE_EMAIL
  CHANGE_PASSWORD
}

enum EmailProvider {
  GMAIL_OAUTH
  GMAIL_PASSWORD
}

// Every DateTime is Timestamptz so the stored value carries its offset. A plain
// `timestamp` keeps no timezone, so anything reading the column directly (psql,
// a GUI, a raw pg query) resolves it against its own timezone and silently
// reports a different instant than the one that was written.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  firstName    String?
  lastName     String?
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  eventsCreated       Event[]              @relation("EventCreator")
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  invitationUsed      Invitation?          @relation("InvitationUsedBy")
  invitationsRevoked  Invitation[]         @relation("InvitationRevoker")
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  code      String
  payload   String?
  expiresAt DateTime   @db.Timestamptz(3)
  usedAt    DateTime?  @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
}

model Invitation {
  id        String           @id @default(cuid())
  email     String?
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  revokedAt DateTime?        @db.Timestamptz(3)

  invitedById String
  invitedBy   User   @relation("InvitationInviter", fields: [invitedById], references: [id])

  usedById String? @unique
  usedBy   User?   @relation("InvitationUsedBy", fields: [usedById], references: [id])

  revokedById String?
  revokedBy   User?   @relation("InvitationRevoker", fields: [revokedById], references: [id])
}

model Event {
  id               String    @id @default(cuid())
  name             String
  description      String?
  slug             String    @unique
  isActive         Boolean   @default(true)
  startsAt         DateTime? @db.Timestamptz(3)
  endsAt           DateTime? @db.Timestamptz(3)
  resultsPublished Boolean   @default(false)
  geofenceEnabled  Boolean   @default(false)
  latitude         Float?
  longitude        Float?
  radiusMeters     Int?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  participants Participant[]
  votes        Vote[]
}

model Participant {
  id           String  @id @default(cuid())
  name         String
  imageUrl     String?
  displayOrder Int     @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  votes Vote[]
}

model Vote {
  id             String   @id @default(cuid())
  voterKey       String
  ipAddress      String?
  fingerprint    String?
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventId, voterKey])
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, createdAt])
}

model EmailConfig {
  id           String        @id
  provider     EmailProvider
  fromName     String
  fromEmail    String
  appPassword  String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
}
